+std::vector<uint32_t> ShipIds(void* fleet) {
+    std::vector<uint32_t> ids;
+    uintptr_t data = 0;
+    uint32_t count = 0;
+    const uintptr_t ships = (uintptr_t)fleet + sdk::ent::CFleet::ships;
+    if (!fleet || !Read((const void*)ships, &data) || !data ||
+        !Read((const void*)(ships + 0xC), &count) || count > 4096) return ids;
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t id = 0xFFFFFFFF;
+        if (Read((const void*)(data + i * sizeof(uint32_t)), &id) && id != 0xFFFFFFFF) ids.push_back(id);
+    }
+    return ids;
+}
