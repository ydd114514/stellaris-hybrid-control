+nlohmann::json GalaxyManager::BuildStations(uint32_t fleet_id, uint32_t system_id,
+                                            const std::string& station_type, bool queue) {
+    Snapshot s = Take();
+    if (!s.player || !OwnFleet(s, fleet_id)) return {{"success", false}, {"error", "Not an owned construction fleet"}};
+    if (!s.index.count(system_id) || Owner(s.systems[s.index[system_id]].obj) != s.player_id)
+        return {{"success", false}, {"error", "Resource stations require an owned system"}};
+    const auto cls = station_type == "mining" ? fleets::ShipClass::MiningStation :
+                     station_type == "research" ? fleets::ShipClass::ResearchStation : fleets::ShipClass::Unknown;
+    if (cls == fleets::ShipClass::Unknown) return {{"success", false}, {"error", "station_type must be mining or research"}};
+    // Same current-build command/factory as outposts. With no single deposit holder,
+    // galactic_object requests the system-wide construction order, as the map menu does.
+    namespace ob = sdk::cmd::build_orbital_station_order;
+    auto cmd = CommandBuilder::Get().Create(ob::kSpec);
+    cmd.Set<uint32_t>(ob::fleet, fleet_id)
+       .Set<uint32_t>(ob::galactic_object, system_id)
+       .Set<uint8_t>(ob::class_, (uint8_t)cls)
+       .Set<uint8_t>(ob::queue, queue ? 1 : 0)
+       .Set<uint8_t>(ob::queue_to_front, 0);
+    std::string why;
+    if (!cmd.IsValid(&why)) return {{"success", false}, {"error", why.empty() ? "No legal resource station order" : why}};
+    if (!cmd.Post(NativeCommand::Check::EngineGate)) return {{"success", false}, {"error", cmd.error()}};
+    return {{"success", true}, {"fleet_id", fleet_id}, {"system_id", system_id},
+            {"system", SystemName(system_id, s.systems[s.index[system_id]].obj)},
+            {"station_type", station_type}, {"queued", queue}, {"message", "Station order posted; verify construction and resource changes"}};
+}
