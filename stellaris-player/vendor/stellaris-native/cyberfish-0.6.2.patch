+                {"ship_class",fleets::ShipClassKey(cls)},{"military_power",fleets::MilitaryPower(fleet)}});
+        }
+        if(!foreign.empty()) result.push_back({{"system_id",sys.id},{"name",SystemName(sys.id,sys.obj)},
+            {"is_capital",sys.id==capital},{"foreign_fleets",foreign}});
+    }
+    return {{"systems",result},{"scanned_owned_systems",scanned},{"total_owned_systems",total},{"truncated",total>scanned},
