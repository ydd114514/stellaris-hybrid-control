diff --git a/stellaris_bridge/src/cyberfish_diplomacy.cpp b/stellaris_bridge/src/cyberfish_diplomacy.cpp
new file mode 100644
index 0000000..b608ef0
--- /dev/null
+++ b/stellaris_bridge/src/cyberfish_diplomacy.cpp
@@ -0,0 +1,119 @@
+// Windows 4.5.2 only: engine-owned proposal factory + normal IsValid/PostCommand.
+#include "cyberfish_diplomacy.hpp"
+#include "command_builder.hpp"
+#include "game_state.hpp"
+#include "contacts_manager.hpp"
+#include <array>
+#include <charconv>
+#include <vector>
+
+namespace bridge::cyberfish {
+namespace {
+struct Action {const char* name; uint32_t token;};
+constexpr Action actions[] = {
+    {"improve_relations",0x351D}, {"establish_embassy",0x3383},
+    {"open_borders",0x3696}, {"close_borders",0x3695},
+    {"research_agreement",0x2A2D}, {"commercial_pact",0x3CB4},
+    {"non_aggression_pact",0x40DA}
+};
+struct Context {uintptr_t base; uint32_t token; void* result;};
+void CreateAction(void* p, void*) {
+    auto* ctx = (Context*)p;
+    // Located from CDiploActionProposeCommand::ReadMembers, not Linux offsets.
+    ctx->result = ((void*(*)(uint32_t))(ctx->base+0x9A9860))(ctx->token);
+}
+NativeCommand Proposal(uint32_t country, uint32_t token) {
+    auto& builder = CommandBuilder::Get();
+    auto command = builder.Create(sdk::cmd::diplo_action_propose_command::kSpec);
+    if (!command) return command;
+    Context context{builder.Base(),token,nullptr};
+    if (!builder.CallGuarded(CreateAction,&context) || !context.result) return command;
+    auto* action = (uint8_t*)context.result;
+    *(uint32_t*)(action+sdk::ent::CDiplomaticAction::actor) = GameState::Get().GetPlayerCountryId();
+    *(uint32_t*)(action+sdk::ent::CDiplomaticAction::recipient) = country;
+    // Factory command starts with a null scoped action; its normal destructor
+    // and PostCommand now own the factory allocation, including query-only calls.
+    command.Set<void*>(0x20,context.result);
+    return command;
+}
+struct Incoming {uint64_t id; uint32_t actor,recipient,token;void* type;};
+bool ReadIncoming(std::vector<Incoming>& rows) {
+    __try {
+        auto* country=(uint8_t*)GameState::Get().GetPlayerCountry();
+        if(!country) return false;
+        const auto offset=sdk::ent::CCountry::incoming_actions;
+        auto* entries=*(uint8_t**)(country+offset);
+        const auto count=*(uint32_t*)(country+offset+0xC);
+        if(count>128 || (count && !entries)) return false;
+        for(uint32_t i=0;i<count;++i) {
+            auto* action=*(uint8_t**)(entries+i*0x10+8);
+            if(!action) continue;
+            auto* type=*(uint8_t**)(action+0x40);
+            Incoming row{*(uint64_t*)(action+0x30),*(uint32_t*)(action+0x20),*(uint32_t*)(action+0x24),type?*(uint32_t*)(type+0x50):0,type};
+            if(row.id && row.recipient==GameState::Get().GetPlayerCountryId()) rows.push_back(row);
+        }
+        return true;
+    } __except(EXCEPTION_EXECUTE_HANDLER) {return false;}
+}
+NativeCommand Response(uint64_t proposal,bool accept) {
+    namespace response=sdk::cmd::diplo_action_respond_command;
+    auto command=CommandBuilder::Get().Create(response::kSpec);
+    command.Set<uint64_t>(response::id,proposal).Set<uint8_t>(response::accept,accept?1:0);
+    return command;
+}
+}
+nlohmann::json Diplomacy(uint32_t country_id, const std::string& requested, bool execute) {
+    auto& builder = CommandBuilder::Get();
+    if (!builder.SdkMatchesExe() || !GameState::Get().GetPlayerCountry())
+        return {{"success",false},{"error","Supported single-player world required"}};
+    const auto contacts = ContactsManager::Get().GetContactsInfo("empires");
+    bool known = false;
+    for (const auto& contact : contacts.value("empires",nlohmann::json::array()))
+        if (contact.value("country_id",0xFFFFFFFFu)==country_id) known=true;
+    if (!known || country_id == GameState::Get().GetPlayerCountryId())
+        return {{"success",false},{"error","Target is not a current known foreign empire"}};
+    nlohmann::json options = nlohmann::json::array();
+    for (const auto& action : actions) {
+        if (!requested.empty() && requested != action.name) continue;
+        auto proposal = Proposal(country_id,action.token);
+        std::string reason;
+        const bool legal = proposal.IsValid(&reason);
+        if (!execute) {options.push_back({{"action",action.name},{"legal",legal},{"reason",reason}}); continue;}
+        if (!legal) return {{"success",false},{"error",reason.empty()?"Native diplomacy conditions not met":reason}};
+        if (!proposal.Post()) return {{"success",false},{"error",proposal.error()}};
+        return {{"success",true},{"country_id",country_id},{"action",action.name},{"phase","proposal_posted"},
+                {"note","Recipient acceptance and any treaty must be observed separately"}};
+    }
+    if (execute) return {{"success",false},{"error","Unsupported diplomatic action"}};
+    return {{"country_id",country_id},{"options",options}};
+}
+nlohmann::json PendingDiplomacy() {
+    std::vector<Incoming> rows;
+    if(!ReadIncoming(rows)) return {{"error","Cannot validate incoming proposal array"}};
+    nlohmann::json result=nlohmann::json::array();
+    for(const auto& row:rows) {
+        auto accept=Response(row.id,true); auto reject=Response(row.id,false);
+        std::string action="unknown_"+std::to_string(row.token);
+        for(const auto& type:actions) if(type.token==row.token) action=type.name;
+        const auto key=row.type?*(std::string*)((uint8_t*)row.type+0x20):std::string();
+        result.push_back({{"proposal",std::to_string(row.id)},{"actor_country_id",row.actor},
+            {"recipient_country_id",row.recipient},{"action",action},
+            {"action_key",key},{"action_name",SafeLocalize(CommandBuilder::Get().Base(),key)},
+            {"can_accept",accept.IsValid()},{"can_reject",reject.IsValid()}});
+    }
+    return {{"pending",result}};
+}
+nlohmann::json RespondDiplomacy(const std::string& proposal,bool accept) {
+    uint64_t identifier=0;
+    auto parsed=std::from_chars(proposal.data(),proposal.data()+proposal.size(),identifier);
+    if(parsed.ec!=std::errc() || parsed.ptr!=proposal.data()+proposal.size() || identifier==0)
+        return {{"success",false},{"error","Invalid proposal identifier"}};
+    std::vector<Incoming> rows;
+    if(!ReadIncoming(rows)) return {{"success",false},{"error","Incoming proposal state unavailable"}};
+    bool known=false; for(const auto& row:rows) if(row.id==identifier) known=true;
+    if(!known) return {{"success",false},{"error","Proposal is no longer pending for this player"}};
+    auto command=Response(identifier,accept);
+    if(!command.Post()) return {{"success",false},{"error",command.error()}};
+    return {{"success",true},{"proposal",proposal},{"accept",accept},{"phase","response_posted"}};
+}
+}
diff --git a/stellaris_bridge/src/cyberfish_picture.cpp b/stellaris_bridge/src/cyberfish_picture.cpp
new file mode 100644
index 0000000..8946e3d
--- /dev/null
+++ b/stellaris_bridge/src/cyberfish_picture.cpp
@@ -0,0 +1,153 @@
+// Evidence comes from the game's own rendered backbuffer, never the desktop.
+#include "cyberfish_picture.hpp"
+#include <filesystem>
+#include <fstream>
+#include <vector>
+#include <wrl/client.h>
+#include "fleet_access.hpp"
+#include "game_state.hpp"
+#include "command_builder.hpp"
+#include <algorithm>
+
+namespace bridge::cyberfish {
+using Microsoft::WRL::ComPtr;
+namespace {IDXGISwapChain* current = nullptr; uint64_t frames=0; void* managed_view=nullptr;}
+void OnPresent(IDXGISwapChain* chain) {current=chain; ++frames;}
+nlohmann::json PictureState() {
+    DXGI_SWAP_CHAIN_DESC desc{};
+    if (!current || FAILED(current->GetDesc(&desc))) return {{"rendering",false}};
+    HWND window=desc.OutputWindow;
+    RECT rect{}; GetClientRect(window,&rect);
+    DWORD process=0; GetWindowThreadProcessId(window,&process);
+    const bool visible=IsWindowVisible(window) && !IsIconic(window) &&
+        process==GetCurrentProcessId() && rect.right>128 && rect.bottom>128;
+    return {{"rendering",true},{"frames",frames},{"visible",visible},
+            {"minimized",!!IsIconic(window)},{"foreground",GetForegroundWindow()==window},
+            {"width",rect.right},{"height",rect.bottom}};
+}
+nlohmann::json CaptureFrame() {
+    const auto picture=PictureState();
+    if (!picture.value("visible",false)) return {{"success",false},{"error","Game picture is not visible"},{"picture",picture}};
+    ComPtr<ID3D11Texture2D> buffer, staging, resolved;
+    ComPtr<ID3D11Device> device; ComPtr<ID3D11DeviceContext> context;
+    if (FAILED(current->GetBuffer(0,__uuidof(ID3D11Texture2D),(void**)buffer.GetAddressOf())))
+        return {{"success",false},{"error","Game backbuffer unavailable"}};
+    buffer->GetDevice(&device); device->GetImmediateContext(&context);
+    D3D11_TEXTURE2D_DESC desc{}; buffer->GetDesc(&desc);
+    if (desc.Width>4096 || desc.Height>2160 ||
+        (desc.Format!=DXGI_FORMAT_R8G8B8A8_UNORM && desc.Format!=DXGI_FORMAT_B8G8R8A8_UNORM &&
+         desc.Format!=DXGI_FORMAT_R8G8B8A8_UNORM_SRGB && desc.Format!=DXGI_FORMAT_B8G8R8A8_UNORM_SRGB))
+        return {{"success",false},{"error","Unsupported evidence buffer format"},{"format",desc.Format}};
+    const bool rgba=desc.Format==DXGI_FORMAT_R8G8B8A8_UNORM || desc.Format==DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    if (desc.SampleDesc.Count>1) {
+        auto single=desc; single.SampleDesc.Count=1; single.SampleDesc.Quality=0;
+        single.BindFlags=0; single.MiscFlags=0;
+        if (FAILED(device->CreateTexture2D(&single,nullptr,&resolved))) return {{"success",false},{"error","Resolve allocation failed"}};
+        context->ResolveSubresource(resolved.Get(),0,buffer.Get(),0,desc.Format);
+    }
+    auto copy=desc; copy.SampleDesc.Count=1; copy.SampleDesc.Quality=0;
+    copy.Usage=D3D11_USAGE_STAGING; copy.BindFlags=0; copy.CPUAccessFlags=D3D11_CPU_ACCESS_READ; copy.MiscFlags=0;
+    if (FAILED(device->CreateTexture2D(&copy,nullptr,&staging))) return {{"success",false},{"error","Staging allocation failed"}};
+    context->CopyResource(staging.Get(),resolved ? resolved.Get() : buffer.Get());
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (FAILED(context->Map(staging.Get(),0,D3D11_MAP_READ,0,&mapped))) return {{"success",false},{"error","Evidence map failed"}};
+    std::vector<uint8_t> pixels(desc.Width*desc.Height*4);
+    for (UINT y=0;y<desc.Height;++y) {
+        const auto* src=(const uint8_t*)mapped.pData+y*mapped.RowPitch;
+        auto* dst=pixels.data()+y*desc.Width*4;
+        memcpy(dst,src,desc.Width*4);
+        for (UINT x=0;x<desc.Width;++x) {if(rgba) std::swap(dst[x*4],dst[x*4+2]); dst[x*4+3]=255;}
+    }
+    context->Unmap(staging.Get(),0);
+    wchar_t temp[MAX_PATH]{}; GetTempPathW(MAX_PATH,temp);
+    const auto folder=std::filesystem::path(temp)/L"Cyberfish"/L"native-frames";
+    std::filesystem::create_directories(folder);
+    const auto path=folder/(std::to_wstring(GetCurrentProcessId())+L"-"+std::to_wstring(frames)+L".bmp");
+    BITMAPFILEHEADER header{}; BITMAPINFOHEADER info{};
+    header.bfType=0x4D42; header.bfOffBits=sizeof(header)+sizeof(info); header.bfSize=header.bfOffBits+(DWORD)pixels.size();
+    info.biSize=sizeof(info); info.biWidth=desc.Width; info.biHeight=-(LONG)desc.Height;
+    info.biPlanes=1; info.biBitCount=32; info.biCompression=BI_RGB; info.biSizeImage=(DWORD)pixels.size();
+    std::ofstream file(path,std::ios::binary);
+    file.write((const char*)&header,sizeof(header)); file.write((const char*)&info,sizeof(info));
+    file.write((const char*)pixels.data(),pixels.size()); file.close();
+    if (!file) return {{"success",false},{"error","Cannot save game frame"}};
+    const auto utf8=path.u8string();
+    return {{"success",true},{"path",std::string(utf8.begin(),utf8.end())},{"picture",picture}};
+}
+nlohmann::json FocusFleet(uint32_t fleet_id) {
+    auto& builder=CommandBuilder::Get();
+    const auto owned=fleets::Owned(GameState::Get().GetPlayerCountry());
+    if (!builder.SdkMatchesExe() || std::find(owned.begin(),owned.end(),fleet_id)==owned.end())
+        return {{"success",false},{"error","Owned fleet required"}};
+    auto* fleet=(uint8_t*)fleets::Find(builder.Base(),fleet_id);
+    auto* idler=(uint8_t*)GameState::Get().GetInGameIdler();
+    if (!fleet || !idler) return {{"success",false},{"error","Fleet or active game missing"}};
+    struct Context {uintptr_t base; void* camera; void* target; int kind;};
+    Context ctx{builder.Base(),idler+0x218,fleet+sdk::rt::CFleet_coordinate_base,-1};
+    auto run=[](void* p,void*) {
+        auto* x=(Context*)p;
+        auto vt=*(void***)x->target;
+        x->kind=((int(*)(void*))vt[5])(x->target);
+        if(x->kind==3) ((void(*)(void*,void*))(x->base+0xF32A40))(x->camera,x->target);
+    };
+    if(!builder.CallGuarded(run,&ctx) || ctx.kind!=3)
+        return {{"success",false},{"error","Verified fleet camera interface unavailable"}};
+    // Camera target at +0x288/+0x28C, assigned by the audited function above.
+    uint32_t selected=*(uint32_t*)(idler+0x4A4);
+    return {{"success",selected==fleet_id},{"fleet_id",fleet_id},{"camera_target_id",selected},
+            {"camera_target_type",*(uint32_t*)(idler+0x4A0)},{"picture",PictureState()}};
+}
+nlohmann::json FocusPlanet(uint32_t planet_id) {
+    auto& builder=CommandBuilder::Get();
+    struct Context {uintptr_t base; uint32_t planet,country; void* idler; bool found;};
+    Context ctx{builder.Base(),planet_id,GameState::Get().GetPlayerCountryId(),GameState::Get().GetInGameIdler(),false};
+    auto run=[](void* p,void*) {
+        auto* x=(Context*)p;
+        auto* db=*(uint8_t**)(x->base+sdk::db::CPlanet);
+        if(!db || !x->idler || (x->planet&0xFFFFFF)>=*(uint32_t*)(db+0x20)) return;
+        auto* arr=*(uint8_t**)(db+0x18);
+        auto* planet=*(uint8_t**)(arr+(x->planet&0xFFFFFF)*16+8);
+        // Actual CPlanet lookup compares +0x18; generated rt::CPlanet_id is a
+        // secondary-base offset and must not be used for a primary pointer.
+        if(!planet || *(uint32_t*)(planet+0x18)!=x->planet || *(uint32_t*)(planet+sdk::ent::CPlanet::owner)!=x->country) return;
+        auto* target=planet+0x20; auto vt=*(void***)target;
+        if(((int(*)(void*))vt[5])(target)!=2) return;
+        ((void(*)(void*,void*))(x->base+0xF32A40))((uint8_t*)x->idler+0x218,target);
+        x->found=true;
+    };
+    if(!builder.SdkMatchesExe() || !builder.CallGuarded(run,&ctx) || !ctx.found)
+        return {{"success",false},{"error","Owned planet camera target unavailable"}};
+    auto* idler=(uint8_t*)ctx.idler;
+    const uint32_t target=*(uint32_t*)(idler+0x4A4);
+    return {{"success",target==planet_id},{"planet_id",planet_id},{"camera_target_id",target},{"camera_target_type",*(uint32_t*)(idler+0x4A0)}};
+}
+nlohmann::json ShowPanel(const std::string& panel) {
+    struct Panel {const char* key; size_t member; uintptr_t vtable;};
+    static constexpr Panel panels[]={
+        {"research",0xD50,0x23F4110},{"fleets",0xD78,0x24106B8},
+        {"contacts",0xD80,0x23F6F98},{"market",0xDC0,0x241B4B8},
+        {"traditions",0xD48,0x241AC98},{"government",0xD40,0x2438858},
+        {"leaders",0xD58,0x23F5778}
+    };
+    auto& builder=CommandBuilder::Get();
+    auto* idler=(uint8_t*)GameState::Get().GetInGameIdler();
+    if(!idler || !builder.SdkMatchesExe()) return {{"success",false},{"error","Game not ready"}};
+    struct Context {void* view; bool show; bool shown;};
+    auto call=[](void* p,void*) {
+        auto* x=(Context*)p; auto vt=*(void***)x->view;
+        ((void(*)(void*))vt[x->show?6:7])(x->view);
+        auto* ui=*(uint8_t**)((uint8_t*)x->view+0x78);
+        x->shown=ui && *(uint8_t*)(ui+0x41)!=0;
+    };
+    void* next=nullptr;
+    for(const auto& candidate:panels) if(panel==candidate.key) {
+        next=*(void**)(idler+candidate.member);
+        if(!next || *(uintptr_t*)next!=builder.Base()+candidate.vtable) return {{"success",false},{"error","View type mismatch"}};
+    }
+    if(panel!="game" && !next) return {{"success",false},{"error","Unknown presentation panel"}};
+    if(managed_view && managed_view!=next) {Context hide{managed_view,false,false}; if(!builder.CallGuarded(call,&hide)) return {{"success",false},{"error","Cannot close managed panel"}};}
+    if(next) {Context show{next,true,false}; if(!builder.CallGuarded(call,&show) || !show.shown) return {{"success",false},{"error","Panel did not become visible"}};}
+    managed_view=next;
+    return {{"success",true},{"panel",panel},{"shown",next!=nullptr},{"picture",PictureState()}};
+}
+}
diff --git a/stellaris_bridge/src/cyberfish_society.cpp b/stellaris_bridge/src/cyberfish_society.cpp
new file mode 100644
index 0000000..3286aea
--- /dev/null
+++ b/stellaris_bridge/src/cyberfish_society.cpp
@@ -0,0 +1,103 @@
+#include "cyberfish_society.hpp"
+#include "command_builder.hpp"
+#include "game_state.hpp"
+#include "government_manager.hpp"
+#include "leader_manager.hpp"
+#include <vector>
+
+namespace bridge::cyberfish {
+namespace {
+struct Definition {void* object; void* category;};
+bool ReadDefinitions(bool ascension,std::vector<Definition>& definitions) {
+    __try {
+        auto base=CommandBuilder::Get().Base();
+        auto address=ascension ? sdk::glob::TGameDatabase_CAscensionPerkDatabase_pInstance : sdk::glob::TGameDatabase_CTraditionTypeDatabase_pInstance;
+        auto* database=*(uint8_t**)(base+address);
+        if(!database) return false;
+        auto** array=*(void***)(database+0x50); uint32_t count=*(uint32_t*)(database+0x5C);
+        if(count>1024 || (count && !array)) return false;
+        for(uint32_t i=0;i<count;++i) if(array[i]) {
+            definitions.push_back({array[i],ascension?nullptr:*(void**)((uint8_t*)array[i]+0x50)});
+        }
+        return true;
+    } __except(EXCEPTION_EXECUTE_HANDLER) {return false;}
+}
+std::string Key(void* p) {
+    if(!p) return "";
+    // Only used for definitions obtained from the bounded native databases.
+    return *(std::string*)((uint8_t*)p+0x20);
+}
+NativeCommand Candidate(const Definition& definition,bool ascension) {
+    auto cmd=CommandBuilder::Get().Create(ascension ? sdk::cmd::activate_ascension_perk_command::kSpec : sdk::cmd::activate_tradition_command::kSpec);
+    cmd.Set<uint32_t>(0x20,GameState::Get().GetPlayerCountryId()).Set<void*>(0x28,definition.object);
+    return cmd;
+}
+}
+nlohmann::json SocietyCandidates(bool ascension) {
+    std::vector<Definition> definitions;
+    if(!GameState::Get().GetPlayerCountry() || !ReadDefinitions(ascension,definitions)) return {{"error","Native society definition database unavailable"}};
+    nlohmann::json candidates=nlohmann::json::array();
+    for(const auto& definition:definitions) {
+        auto command=Candidate(definition,ascension); std::string reason;
+        if(!command.IsValid(&reason)) continue;
+        auto key=Key(definition.object);
+        if(!ascension && (key.ends_with("_finish") || key.ends_with("_finisher"))) continue;
+        nlohmann::json row={{"key",key},{"name",SafeLocalize(CommandBuilder::Get().Base(),key)},{"legal",true}};
+        if(definition.category) {auto category=Key(definition.category); row["tree_key"]=category;}
+        candidates.push_back(row);
+    }
+    return {{"candidates",candidates},{"kind",ascension?"ascension_perk":"tradition"},
+            {"note","Only candidates accepted by the normal native command's IsValid"}};
+}
+nlohmann::json AdoptAscension(const std::string& key) {
+    std::vector<Definition> definitions;
+    if(!ReadDefinitions(true,definitions)) return {{"success",false},{"error","Ascension database unavailable"}};
+    for(const auto& definition:definitions) if(Key(definition.object)==key) {
+        auto command=Candidate(definition,true);
+        if(!command.Post()) return {{"success",false},{"error",command.error()}};
+        return {{"success",true},{"perk_key",key},{"phase","ascension_posted"}};
+    }
+    return {{"success",false},{"error","Unknown ascension key"}};
+}
+nlohmann::json CouncilCandidates() {
+    const auto government=GovernmentManager::Get().GetGovernmentJson();
+    const auto leaders=LeaderManager::Get().GetLeadersJson();
+    nlohmann::json candidates=nlohmann::json::array();
+    for(const auto& seat:government.value("council_seats",nlohmann::json::array())) {
+        if(seat.value("is_ruler",true) || seat.value("is_assigned",true)) continue;
+        // Only these vanilla positions have audited class requirements. Other
+        // civic/modded seats remain unavailable until their native UI predicate
+        // is adapted; command IsValid alone only validates the two handles.
+        const auto key=seat.value("position_key",std::string());
+        const std::string required=key=="councilor_research"?"scientist":key=="councilor_defense"?"commander":key=="councilor_state"?"official":"";
+        if(required.empty() || seat.value("position_id",0xFFFFFFFFu)==0xFFFFFFFFu) continue;
+        for(const auto& leader:leaders.value("hired_leaders",nlohmann::json::array())) {
+            if(leader.value("assignment_type",std::string())!="unassigned") continue;
+            if(leader.value("class",std::string())!=required) continue;
+            bool assigned=false;
+            for(const auto& occupied:government.value("council_seats",nlohmann::json::array()))
+                if(occupied.contains("leader") && occupied["leader"].is_object() && occupied["leader"].value("id",0xFFFFFFFFu)==leader.value("id",0xFFFFFFFFu)) assigned=true;
+            if(assigned) continue;
+            namespace assign=sdk::cmd::add_to_council_command;
+            auto command=CommandBuilder::Get().Create(assign::kSpec);
+            command.Set<uint32_t>(assign::leader,leader.value("id",0xFFFFFFFFu))
+                .Set<uint32_t>(assign::council_position,seat.value("position_id",0xFFFFFFFFu));
+            if(command.IsValid()) candidates.push_back({{"leader_id",leader["id"]},{"seat_index",seat["seat_index"]},
+                {"position_id",seat["position_id"]},{"leader_name",leader.value("name",std::string())},
+                {"position",seat.value("position_name",std::string())},{"legal",true}});
+        }
+    }
+    return {{"candidates",candidates}};
+}
+nlohmann::json AssignCouncilor(uint32_t leader,uint32_t seat) {
+    const auto current=CouncilCandidates();
+    for(const auto& row:current["candidates"]) if(row["leader_id"]==leader && row["seat_index"]==seat) {
+        namespace C=sdk::cmd::add_to_council_command;
+        auto cmd=CommandBuilder::Get().Create(C::kSpec);
+        cmd.Set<uint32_t>(C::leader,leader).Set<uint32_t>(C::council_position,row["position_id"].get<uint32_t>());
+        if(!cmd.Post()) return {{"success",false},{"error",cmd.error()}};
+        return {{"success",true},{"leader_id",leader},{"seat_index",seat},{"position_id",row["position_id"]},{"phase","council_assignment_posted"}};
+    }
+    return {{"success",false},{"error","No current owned, vacant, compatible council appointment"}};
+}
+}
